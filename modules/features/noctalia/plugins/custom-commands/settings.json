{
  "commands": [
    {
      "name": "File Manager",
      "command": "xdg-open ~",
      "icon": "folder"
    },
    {
      "name": "System Monitor",
      "command": "gnome-system-monitor || plasma-systemmonitor || xfce4-taskmanager",
      "icon": "activity"
    },
    {
      "name": "Enable Conservative Mode",
      "command": "echo 1 > /sys/devices/pci0000:00/0000:00:1f.0/PNP0C09:00/VPC2004:00/conservation_mode",
      "icon": "battery-eco"
    },
    {
      "name": "Disable Conservative Mode",
      "command": "echo 0 > /sys/devices/pci0000:00/0000:00:1f.0/PNP0C09:00/VPC2004:00/conservation_mode",
      "icon": "battery-filled"
    }
  ]
}
